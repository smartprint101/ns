# ── এনএস ট্রেডার্স — Environment Variables ──────────────────────────────
# Copy to `.env` locally, or set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real secrets.

# ── Database ──
# Driver: "postgres" for a hosted PostgreSQL (production) | "pglite" for the embedded local dev DB.
DB_DRIVER="postgres"

# PostgreSQL connection string (production).
# Neon example: postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/nsdb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Only for DB_DRIVER=pglite (local dev): where to store DB files.
# PGLITE_DATA_DIR="./.pgdata"

# ── Auth ──
# Random 32+ char secret for signing login sessions. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# ── First admin (Owner) — used once by seed on an empty database ──
SEED_ADMIN_NAME="শরীফুল"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Staff users সাইফুল/রহমান/নিরব — ফাঁকা database-এ প্রথম seed-এ তৈরি হবে (hashed)।
# Live হওয়ার পর প্রত্যেকে নিজের পাসওয়ার্ড সেটিংস থেকে বদলে নেবে। বাদ দিলে Owner করে টিম পেজ থেকে যোগ করুন।
# SEED_STAFF_PASSWORD="choose-a-shared-first-password"

# Seed a few demo factories/cylinders/parties on first boot? (1 = yes, 0 = no)
SEED_DEMO="0"

# Optional: apply SQL migrations automatically when the server boots (else use `npm run db:migrate`).
# RUN_MIGRATIONS="0"
